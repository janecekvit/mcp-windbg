<Project>
  <!-- Settings shared by every project in DumpAnalyzer.slnx. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <Authors>Vít Janeček</Authors>
    <Copyright>Copyright 2025-2026 Vít Janeček</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/janecekvit/mcp-windbg</RepositoryUrl>
  </PropertyGroup>

  <!--
    Supply-chain hygiene: audit direct AND transitive packages on every restore
    and fail the build on High/Critical advisories (NU1903/NU1904), so a
    vulnerable dependency cannot slip into a release unnoticed.
  -->
  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <WarningsAsErrors>$(WarningsAsErrors);NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>
</Project>
